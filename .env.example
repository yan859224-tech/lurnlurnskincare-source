# Optional: enable real Supabase email/password authentication.
# Customer storefront may use separate demo data. Staff login requires a configured backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional real public Telegram username (no @)
VITE_TELEGRAM_USERNAME=

# Illustrative display-only conversion rate; NOT a live FX rate.
VITE_KHR_PER_USD=4000

# Optional social profiles (only add real official store URLs)
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=

# REQUIRED to activate Admin / Super Admin login. Use HTTPS in production and server-managed HttpOnly cookies.
# Without this setting, staff login is locked. Never put staff passwords in frontend files.
VITE_API_BASE_URL=

# Never put TELEGRAM_BOT_TOKEN or TELEGRAM_STORE_CHAT_ID here. Backend only.
